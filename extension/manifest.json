{
  "manifest_version": 3,
  "name": "AI Content Flag",
  "version": "0.6.0",
  "description": "Flags AI-suspicious paragraphs green/yellow/red with a score – runs locally in your browser or via a cloud backend you pick.",
  "permissions": [
    "storage",
    "activeTab",
    "offscreen",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://127.0.0.1/*",
        "*://localhost/*"
      ],
      "js": [
        "generated/blocklist.js",
        "models.js",
        "config.js",
        "lang-detect.js",
        "manual-check.js",
        "content-popover.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "AI Content Flag",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "commands": {
    "toggle-enabled": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Switch extension on/off"
    },
    "scan-page": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Scan current page now"
    },
    "check-selection": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Check selected text for AI"
    }
  }
}
