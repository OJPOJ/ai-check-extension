{
  "manifest_version": 3,
  "name": "AI Content Flag",
  "version": "0.5.0",
  "description": "Bewertet Textabsätze mit einem KI-Text-Klassifikator – direkt im Browser, lokal oder per Cloud – und markiert sie grün/gelb/rot mit Score.",
  "permissions": [
    "storage",
    "activeTab",
    "offscreen",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://127.0.0.1/*",
        "*://localhost/*"
      ],
      "js": [
        "generated/blocklist.js",
        "models.js",
        "config.js",
        "lang-detect.js",
        "content-popover.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "AI Content Flag",
    "default_popup": "popup.html"
  },
  "commands": {
    "toggle-enabled": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Extension an-/ausschalten"
    },
    "scan-page": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Aktuelle Seite jetzt scannen"
    },
    "check-selection": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Markierten Text auf KI prüfen"
    }
  }
}
