{
  "manifest_version": 3,
  "name": "AI Content Flag",
  "version": "0.2.0",
  "description": "Bewertet Textabsätze mit einem austauschbaren KI-Text-Klassifikator (lokal oder Cloud) und markiert sie grün/gelb/rot mit Score.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["*://127.0.0.1/*", "*://localhost/*"],
      "js": ["config.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "AI Content Flag",
    "default_popup": "popup.html"
  },
  "commands": {
    "toggle-enabled": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Extension an-/ausschalten"
    },
    "scan-page": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Aktuelle Seite jetzt scannen"
    }
  }
}
